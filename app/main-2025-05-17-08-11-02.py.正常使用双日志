async def detection_endpoint(
        request: Request,
        file: Optional[UploadFile] = File(None),
        image: Optional[str] = Form(None)
):
    start_time = time.time()
    try:
        if file is None and image is None:
            response = APIResponse(code=400, message="Either file or image must be provided")
            await log_request_response(request, response.dict(), time.time() - start_time)
            return response

        image_bytes = await decode_image(file or image)
        bboxes = ocr_service.detection(image_bytes)
        response = APIResponse(code=200, message="Success", data=bboxes)
        await log_request_response(request, response.dict(), time.time() - start_time)
        return response
    except Exception as e:
        response = APIResponse(code=500, message=str(e))
        logger.error(f"Detection Error: {str(e)}", exc_info=True)
        await log_request_response(request, response.dict(), time.time() - start_time)
